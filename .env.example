# Copy to .env and load with `node --env-file=.env` or export the variables.

# HTTP port (1–65535)
PORT=3200

# sql (Sequelize over DATABASE_URL) or memory (lost on restart)
STORAGE=sql

# Any Sequelize URL; SQLite file by default (relative to backend/)
# PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/retrace  (see _docs/deploy-postgres.md)
DATABASE_URL=sqlite:data/retrace.db

# production: no demo data
NODE_ENV=development

# --- Docker Compose (#108) ---
POSTGRES_USER=retrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retrace
# Synthetic demo data in production (public demo); investigators use demo-password.
SEED_DEMO=true
# Admin password instead of the documented demo one (at least 12 characters).
ADMIN_PASSWORD=
APP_PORT=3200
