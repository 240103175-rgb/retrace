{
  "name": "@retrace/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "validate:api": "node -e \"require('@apidevtools/swagger-parser').validate('../openapi.yml').then(()=>console.log('openapi.yml is valid'))\"",
    "db:reset": "node scripts/reset-db.js",
    "smoke": "node scripts/smoke.mjs",
    "test:postgres": "node --test --test-concurrency=1 test/services.test.js test/features.test.js test/attachments.test.js test/extract.test.js test/api.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
